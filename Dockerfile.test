FROM docker.io/library/node:24-bookworm-slim AS core

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake git \
    && rm -rf /var/lib/apt/lists/*

ARG LIBCOAP_REF=develop
RUN git clone --depth 1 --branch "$LIBCOAP_REF" https://github.com/obgm/libcoap.git /opt/libcoap \
    && cmake -S /opt/libcoap -B /tmp/libcoap-build \
       -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
       -DENABLE_DTLS=OFF -DENABLE_DOCS=OFF -DENABLE_EXAMPLES=ON \
       -DENABLE_WS=ON -DENABLE_PROXY_CODE=OFF \
    && cmake --build /tmp/libcoap-build --target coap-server --parallel \
    && cp /tmp/libcoap-build/coap-server /usr/local/bin/coap-server

RUN npm install --prefix /opt/coap-test --no-audit --no-fund ws@8
ENV NODE_PATH=/opt/coap-test/node_modules

COPY docker/test/start.sh /usr/local/bin/test-libcoap-wasm
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/test-libcoap-wasm"]

FROM core AS browser

RUN npm install --prefix /opt/coap-test --no-audit --no-fund ws@8 playwright \
    && /opt/coap-test/node_modules/.bin/playwright install --with-deps --only-shell chromium
RUN apt-get update && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

COPY docker/coap-explorer/nginx.conf /etc/nginx/nginx.conf
RUN mkdir -p /srv && ln -s /workspace /srv/project
